<?xml version="1.0"?>
<robot name="sensor_sick_multiscan100" xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:macro name="sensor_sick_multiscan100" params="prefix parent prefix_topic:='multiscan' *origin max_angle:=3.14159 min_angle:=-3.14159 gpu:=^|true include_inertial:=^|true">

        <joint name="${prefix}_base_joint" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}"/>
            <child link="${prefix}_base_link"/>
        </joint>

        <link name="${prefix}_base_link">
            <collision>
                <origin xyz="0 0 0.076" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.051" length="0.152"/>
                </geometry>
            </collision>

            <visual>
                <origin xyz="0 0 0.076" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.051" length="0.152"/>
                </geometry>
                <material name="sick_blue">
                    <color rgba="0.0 0.43 0.73 1.0"/>
                </material>
            </visual>

            <xacro:if value="${include_inertial}">
                <inertial>
                    <mass value="1.24" /> <origin xyz="0 0 0.076" rpy="0 0 0"/>
                    <xacro:solid_cylinder_inertia m="1.24" r="0.051" h="0.152" />
                </inertial>
            </xacro:if>
        </link>

        <joint name="${prefix}_joint" type="fixed">
            <parent link="${prefix}_base_link"/>
            <child link="${prefix}_link"/>
            <origin xyz="0.0 0 0.1095" rpy="0 0 0"/>
        </joint>

        <link name="${prefix}_link" />

        <xacro:sensor_sick_multiscan100_gazebo />

    </xacro:macro>

    <xacro:macro name="sensor_sick_multiscan100_gazebo">
        <gazebo reference="${prefix}_link">

            <xacro:if value="${gpu}">
                <xacro:property name="ray_type" value="gpu_ray" />
                <xacro:property name="plugin_lib" value="libgazebo_ros_velodyne_gpu_laser.so" />
            </xacro:if>
            <xacro:unless value="${gpu}">
                <xacro:property name="ray_type" value="ray" />
                <xacro:property name="plugin_lib" value="libgazebo_ros_velodyne_laser.so" />
            </xacro:unless>

            <sensor type="${ray_type}" name="${prefix}_sensor">
                <pose>0 0 0 0 0 0</pose>
                <visualize>false</visualize>
                <update_rate>15</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>${min_angle}</min_angle>
                            <max_angle>${max_angle}</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>16</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.2617</min_angle> <max_angle>0.2617</max_angle>  </vertical>
                    </scan>
                    <range>
                        <min>0.10</min>
                        <max>60.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </ray>
                <plugin name="${prefix}_controller" filename="${plugin_lib}">
                    <topicName>${prefix_topic}/points</topicName>
                    <frameName>${prefix}_link</frameName>
                    <organize_cloud>false</organize_cloud>
                    <min_range>0.2</min_range>
                    <max_range>60.0</max_range>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>

</robot>