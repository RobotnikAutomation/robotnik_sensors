<?xml version="1.0"?>
<robot name="sensor_fuke_sv600" xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="sensor_fuke_sv600" params="prefix parent prefix_topic:='front_color_camera' *origin include_inertial:=^|true">

    <joint name="${prefix}_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}_link"/>
    </joint>

    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotnik_sensors/meshes/fluke_sv600.STL" scale="1.0 1.0 1.0"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotnik_sensors/meshes/fluke_sv600.STL" scale="1.0 1.0 1.0"/>
        </geometry>
      </collision>
      <xacro:if value="${include_inertial}">
        <inertial>
          <mass value="0.1"/>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <xacro:solid_cuboid_inertia m="0.1" w="0.08" h="0.06" d="0.03"/>
        </inertial>
      </xacro:if>
    </link>

    <joint name="${prefix}_rgb_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}_link"/>
      <child link="${prefix}_rgb_frame"/>
    </joint>

    <link name="${prefix}_rgb_frame">
      <xacro:if value="${include_inertial}">
        <inertial>
          <mass value="0.001"/>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <xacro:solid_cuboid_inertia m="0.001" w="0.01" h="0.01" d="0.01"/>
        </inertial>
      </xacro:if>
    </link>

    <joint name="${prefix}_rgb_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}"/>
      <parent link="${prefix}_rgb_frame"/>
      <child link="${prefix}_rgb_optical_frame"/>
    </joint>

    <link name="${prefix}_rgb_optical_frame">
      <xacro:if value="${include_inertial}">
        <inertial>
          <mass value="0.001"/>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <xacro:solid_cuboid_inertia m="0.001" w="0.01" h="0.01" d="0.01"/>
        </inertial>
      </xacro:if>
    </link>

    <xacro:sensor_fuke_sv600_gazebo/>

  </xacro:macro>

  <xacro:macro name="sensor_fuke_sv600_gazebo">
    <gazebo reference="${prefix}_link">
      <sensor type="camera" name="${prefix}_color_sensor">
        <always_on>true</always_on>
        <update_rate>20.0</update_rate>
        <camera>
          <horizontal_fov>${60.0*M_PI/180.0}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>100.0</far>
          </clip>
        </camera>
        <plugin name="${prefix}_controller" filename="libgazebo_ros_camera.so">
          <cameraName>${prefix_topic}</cameraName>
          <alwaysOn>true</alwaysOn>
          <updateRate>20.0</updateRate>
          <imageTopicName>color/image_raw</imageTopicName>
          <cameraInfoTopicName>color/camera_info</cameraInfoTopicName>
          <frameName>/${prefix}_rgb_optical_frame</frameName>
          <distortionK1>0.0</distortionK1>
          <distortionK2>0.0</distortionK2>
          <distortionK3>0.0</distortionK3>
          <distortionT1>0.0</distortionT1>
          <distortionT2>0.0</distortionT2>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
