<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="sensor_axis_1798le">

  <xacro:macro name="sensor_axis_1798le" params="prefix parent *origin far:=^|8.0 near:=^|0.05">

    <!-- Camera base frame -->

    <joint name="${prefix}_joint" type="fixed">
      <axis xyz="0 1 0"/>
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}_link"/>
    </joint>

    <link name="${prefix}_link">

      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <mass value="0.01"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.1e-9" ixy="0" ixz="0" iyy="0.1e-9" iyz="0" izz="0.1e-9"/>
      </inertial>

      <visual>
        <material name="axis_color">
          <color rgba="0.8 0.8 0.8 1"/>
        </material>
        <origin xyz="0.216 0.0 0.117" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotnik_sensors/meshes/axis_1798le.stl" />
        </geometry>
      </visual>

      <collision>
        <origin xyz="0.216 0.0 0.117" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotnik_sensors/meshes/axis_1798le.stl" /> 
        </geometry>
      </collision>

    </link>


    <!-- Optical frame -->

    <joint name="${prefix}_optical_joint" type="fixed">
      <origin xyz="0.216 0.0 0.117" rpy="${-M_PI/2} 0 ${-M_PI/2}"/>
      <parent link="${prefix}_link"/>
      <child link="${prefix}_optical_link"/>
    </joint>

    <link name="${prefix}_optical_link"/>


    <!-- Axis sensor for simulation -->
    <sensor_axis_1798le_gazebo/> 


  </xacro:macro>


  <xacro:macro name="sensor_axis_1798le_gazebo">

    <gazebo reference="${prefix}_link">
      <material>Gazebo/Grey</material>
    </gazebo>

      <!-- TO DO: calibration is requiered  -->
    <gazebo reference="${prefix}_link">
      <sensor type="camera" name="${prefix}_sensor">
        <update_rate>30.0</update_rate>
        <camera>
          <horizontal_fov>${60.0*M_PI/180.0}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>${near}</near>
            <far>${far}</far>
          </clip>
        </camera>
        <plugin name="${prefix}_controller" filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <cameraName>${prefix}</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>/${prefix}_optical_link</frameName>
          <hackBaseline>0.0</hackBaseline>
          <distortionK1>0.0</distortionK1>
          <distortionK2>0.0</distortionK2>
          <distortionK3>0.0</distortionK3>
          <distortionT1>0.0</distortionT1>
          <distortionT2>0.0</distortionT2>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
