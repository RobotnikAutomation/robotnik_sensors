<?xml version="1.0"?>
<robot name="sensor_gps" xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Note: gps_latitude/longitude are NOT needed anymore; world defines WGS84 origin -->
  <xacro:macro name="sensor_gps" params="prefix parent *origin update_rate:=^|5 include_inertial:=^|true frame_id:=^|${prefix}_base_link topic_ns:=^|gps">

    <!-- ANTENNA GPS -->
    <joint name="${prefix}_joint" type="fixed">
      <axis xyz="0 1 0"/>
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}_base_link"/>
    </joint>

    <link name="${prefix}_base_link">
      <xacro:if value="${include_inertial}">
        <inertial>
          <origin xyz="0.0 0 0.015" rpy="0 0 0" />
          <mass value="0.2" />
          <xacro:solid_cuboid_inertia m="0.2" w="0.081" h="0.081" d="0.03" />
        </inertial>
      </xacro:if>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <material name="gps_color">
          <color rgba="1 1 1 1"/>
        </material>
        <geometry>
          <mesh filename="package://robotnik_sensors/meshes/antenna_3GO16.stl" scale="1.0 1.0 1.0"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://robotnik_sensors/meshes/antenna_3GO16.stl" scale="1.0 1.0 1.0"/>
        </geometry>
      </collision>
    </link>

    <!-- Gazebo visuals/physics for the link -->
    <gazebo reference="${prefix}_base_link">
      <material>Gazebo/White</material>
      <gravity>true</gravity>
    </gazebo>

    <!-- Native Gazebo GPS sensor + ROS bridge -->
    <gazebo reference="${prefix}_base_link">
      <sensor name="${prefix}_gps" type="gps">
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>

        <!-- Native GPS noise model; tune to your needs -->
        <gps>
          <position_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev> <!-- ~0.05 m horiz -->
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev> <!-- ~0.05 m vert -->
              </noise>
            </vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.02</stddev>
              </noise>
            </vertical>
          </velocity_sensing>
        </gps>

        <!-- ROS bridge: publishes NavSatFix (+ optional velocity) -->
        <plugin name="${prefix}_ros_gps" filename="libgazebo_ros_gps.so">
          <!-- Namespace is optional; leave '/' for absolute topics or set a relative ns -->
          <ros>
            <namespace>/</namespace>
          </ros>

          <!-- Frame id used in published messages -->
          <frame_name>${frame_id}</frame_name>

          <!-- Topics: you can remap at launch if needed -->
          <topic_name>${topic_ns}/fix</topic_name>
          <velocity_topic_name>${topic_ns}/fix_velocity</velocity_topic_name>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
