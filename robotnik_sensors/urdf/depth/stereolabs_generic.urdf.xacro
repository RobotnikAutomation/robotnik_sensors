<?xml version="1.0" ?>
<robot
  name="sensor_stereolabs_generic"
  xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include
    filename="$(find robotnik_sensors)/urdf/depth/depth_camera_plugin.urdf.xacro" />
  <xacro:include
    filename="$(find robotnik_sensors)/urdf/depth/irred_camera_plugin.urdf.xacro" />
  <xacro:include
    filename="$(find robotnik_sensors)/urdf/camera/camera_plugin.urdf.xacro" />

  <xacro:macro
    name="sensor_stereolabs_generic"
    params="frame_prefix
            parent
            *origin
            model:=zed2
            gazebo_ignition:=false
            node_name:=stereolabs_generic
            node_namespace:=${None}
            topic_prefix:=~/
            horizontal_fov:=80
            vertical_fov:=60
            video_width:=1280
            video_height:=720
            video_fps:=30
            min_depth:=0.4
            max_depth:=6.5
            low_performance:=${low_performance}">
    <!-- node_namespace is used from node_name if not set -->
    <xacro:if value="${node_namespace == None}">
      <xacro:property
        name="node_namespace"
        value="${node_name}" />
    </xacro:if>

    <xacro:if value="${model == 'zed'}">
      <xacro:property name="baseline" value="0.12" />
      <xacro:property name="height" value="0.03" />
      <xacro:property name="bottom_slope" value="0.05" />
      <xacro:property name="screw_offset_x" value="0.0" />
      <xacro:property name="screw_offset_z" value="0.0" />
      <xacro:property name="optical_offset_x" value="-0.01" />
      <xacro:property name="mono" value="false" />
      <xacro:property name="mat" value="0.8 0.8 0.8 1.0" />
      <!-- Offset from ZED reference center to Robotnik sensor reference point-->
      <xacro:property name="base_offset_x" value="0.0165" />
      <xacro:property name="base_offset_z" value="-0.015" />
    </xacro:if>

    <xacro:if value="${model == 'zed2'}">
      <xacro:property name="baseline" value="0.12" />
      <xacro:property name="height" value="0.03" />
      <xacro:property name="bottom_slope" value="0.05" />
      <xacro:property name="screw_offset_x" value="0.0" />
      <xacro:property name="screw_offset_z" value="0.0" />
      <xacro:property name="optical_offset_x" value="-0.01" />
      <xacro:property name="mono" value="false" />
      <xacro:property name="mat" value="0.25 0.25 0.25 1.0" />
      <!-- Offset from ZED reference center to Robotnik sensor reference point-->
      <xacro:property name="base_offset_x" value="0.0155" />
      <xacro:property name="base_offset_z" value="-0.01325" />
    </xacro:if>

    <xacro:if value="${model == 'zed2i'}">
      <xacro:property name="baseline" value="0.12" />
      <xacro:property name="height" value="0.03" />
      <xacro:property name="bottom_slope" value="0.0" />
      <xacro:property name="screw_offset_x" value="-0.01" />
      <xacro:property name="screw_offset_z" value="0.0" />
      <xacro:property name="optical_offset_x" value="-0.01" />
      <xacro:property name="mono" value="false" />
      <xacro:property name="mat" value="0.25 0.25 0.25 1.0" />
      <!-- Offset from ZED reference center to Robotnik sensor reference point-->
      <xacro:property name="base_offset_x" value="0.0215" />
      <xacro:property name="base_offset_z" value="-0.015" />
    </xacro:if>

    <xacro:if value="${model == 'zedx'}">
      <xacro:property name="baseline" value="0.12" />
      <xacro:property name="height" value="0.032" />
      <xacro:property name="bottom_slope" value="0.0" />
      <xacro:property name="screw_offset_x" value="0.0" />
      <xacro:property name="screw_offset_z" value="-0.016" />
      <xacro:property name="optical_offset_x" value="-0.01" />
      <xacro:property name="mono" value="false" />
      <xacro:property name="mat" value="0.25 0.25 0.25 1.0" />
      <!-- Offset from ZED reference center to Robotnik sensor reference point-->
      <xacro:property name="base_offset_x" value="0.01875" />
      <xacro:property name="base_offset_z" value="-0.016" />
    </xacro:if>

    <xacro:if value="${model == 'zedxm'}">
      <xacro:property name="baseline" value="0.05" />
      <xacro:property name="height" value="0.032" />
      <xacro:property name="bottom_slope" value="0.0" />
      <xacro:property name="screw_offset_x" value="0.0" />
      <xacro:property name="screw_offset_z" value="-0.016" />
      <xacro:property name="optical_offset_x" value="-0.01" />
      <xacro:property name="mono" value="false" />
      <xacro:property name="mat" value="0.25 0.25 0.25 1.0" />
      <!-- Offset from ZED reference center to Robotnik sensor reference point-->
      <xacro:property name="base_offset_x" value="0.01875" />
      <xacro:property name="base_offset_z" value="-0.016" />
    </xacro:if>

    <!-- User-defined sensor mounting position and orientation -->

    <joint
      name="${frame_prefix}camera_base_joint"
      type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${frame_prefix}base_link" />
    </joint>

    <!-- Intermediate frame to apply the offset from the ZED reference center to
    the Robotnik sensor reference point (geometric center of the rear/bottom face) -->

    <link name="${frame_prefix}base_link" />
    <joint
      name="${frame_prefix}camera_joint"
      type="fixed">
      <origin xyz="${base_offset_x} 0 ${base_offset_z}" rpy="0 0 0"/>
      <parent link="${frame_prefix}base_link" />
      <child link="${frame_prefix}camera_link" />
    </joint>

    <!-- ZED-specific frames and geometry -->

    <!-- Camera mounting point (the threaded screw hole in the bottom) -->
    <link name="${frame_prefix}camera_link" />
    
    <!-- Camera Center -->
    <link name="${frame_prefix}camera_center">
      <xacro:unless value="${model == 'virtual'}">
        <visual>
          <origin xyz="${screw_offset_x} 0 ${screw_offset_z}" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://robotnik_sensors/meshes/depth/stereolabs_zed/${model}.stl"/>
          </geometry>
          <material name="cam_mat">
            <color rgba="${mat}"/>
          </material>
        </visual>
        <collision>
          <origin xyz="${screw_offset_x} 0 ${screw_offset_z}" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://robotnik_sensors/meshes/depth/stereolabs_zed/${model}.stl"/>
          </geometry>
        </collision>
      </xacro:unless>
    </link>
    <joint name="${frame_prefix}camera_center_joint" type="fixed">
      <parent link="${frame_prefix}camera_link"/>
      <child link="${frame_prefix}camera_center"/>
      <origin xyz="0 0 ${height/2}" rpy="0 ${bottom_slope} 0" />
    </joint>

    <xacro:unless value="${mono}">
      <!-- Left Camera -->
      <link name="${frame_prefix}left_camera_frame">
        <xacro:if value="${model == 'virtual'}">
          <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robotnik_sensors/meshes/depth/stereolabs_zed/${model}.stl"/>
            </geometry>
            <material name="cam_mat">
              <color rgba="${mat}"/>
            </material>
          </visual>
          <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robotnik_sensors/meshes/depth/stereolabs_zed/${model}.stl"/>
            </geometry>
          </collision>
        </xacro:if>
      </link>
      <joint name="${frame_prefix}left_camera_joint" type="fixed">
        <parent link="${frame_prefix}camera_center"/>
        <child link="${frame_prefix}left_camera_frame"/>
        <origin xyz="${optical_offset_x} ${baseline/2} 0" rpy="0 0 0" />
      </joint>

<link name="${frame_prefix}left_camera_frame_optical"/>
      <joint name="${frame_prefix}left_camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-${pi/2} 0.0 -${pi/2}"/>
        <parent link="${frame_prefix}left_camera_frame"/>
<child link="${frame_prefix}left_camera_frame_optical"/>
      </joint>

      <!-- Right Camera -->
      <link name="${frame_prefix}right_camera_frame">
        <xacro:if value="${model == 'virtual'}">
          <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robotnik_sensors/meshes/depth/stereolabs_zed/${model}.stl"/>
            </geometry>
            <material name="cam_mat">
              <color rgba="${mat}"/>
            </material>
          </visual>
          <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robotnik_sensors/meshes/depth/stereolabs_zed/${model}.stl"/>
            </geometry>
          </collision>
        </xacro:if>
      </link>
      <joint name="${frame_prefix}right_camera_joint" type="fixed">
        <parent link="${frame_prefix}camera_center"/>
        <child link="${frame_prefix}right_camera_frame"/>
        <origin xyz="${optical_offset_x} -${baseline/2} 0" rpy="0 0 0" />
      </joint>

<link name="${frame_prefix}right_camera_frame_optical"/>
      <joint name="${frame_prefix}right_camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-${pi/2} 0.0 -${pi/2}"/>
        <parent link="${frame_prefix}right_camera_frame"/>
<child link="${frame_prefix}right_camera_frame_optical"/>
      </joint>

      <!-- ZED2 Sensors -->
      <xacro:if value="${model == 'zed2'}">
        <link name="${frame_prefix}mag_link" />
        <joint name="${frame_prefix}mag_joint" type="fixed">
          <parent link="${frame_prefix}camera_center"/>
          <child link="${frame_prefix}mag_link"/>
          <origin xyz="0 0 0" rpy="0 0 0" />
        </joint>

        <link name="${frame_prefix}baro_link" />
        <joint name="${frame_prefix}baro_joint" type="fixed">
          <parent link="${frame_prefix}camera_center"/>
          <child link="${frame_prefix}baro_link"/>
          <origin xyz="0 0 0" rpy="0 0 0" />
        </joint>

        <link name="${frame_prefix}temp_left_link" />
        <joint name="${frame_prefix}temp_left_joint" type="fixed">
          <parent link="${frame_prefix}left_camera_frame"/>
          <child link="${frame_prefix}temp_left_link"/>
          <origin xyz="0 0 0" rpy="0 0 0" />
        </joint>

        <link name="${frame_prefix}temp_right_link" />
        <joint name="${frame_prefix}temp_right_joint" type="fixed">
          <parent link="${frame_prefix}right_camera_frame"/>
          <child link="${frame_prefix}temp_right_link"/>
          <origin xyz="0 0 0" rpy="0 0 0" />
        </joint>
      </xacro:if>      
    </xacro:unless>

    <xacro:if value="${mono}">
      <!-- Camera -->
      <link name="${frame_prefix}camera_frame" />
      <joint name="${frame_prefix}camera_joint" type="fixed">
        <parent link="${frame_prefix}camera_center"/>
        <child link="${frame_prefix}camera_frame"/>
        <origin xyz="${optical_offset_x} 0 0" rpy="0 0 0" />
      </joint>

<link name="${frame_prefix}camera_frame_optical"/>
      <joint name="${frame_prefix}camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-${pi/2} 0.0 -${pi/2}"/>
        <parent link="${frame_prefix}camera_frame"/>
<child link="${frame_prefix}camera_frame_optical"/>
      </joint>
    </xacro:if>

    <xacro:if value="$(arg low_performance)">
      <xacro:camera_plugin
        node_namespace="${node_namespace}"
        node_name="${node_name}_right_sensor"
        topic_prefix="${topic_prefix}_right_sensor"
        gazebo_ignition="${gazebo_ignition}"
        optical_frame="${frame_prefix}right_camera_frame_optical"
        reference_frame="${frame_prefix}right_frame_optical"
        horizontal_fov="${horizontal_fov}"
        vertical_fov="${vertical_fov}"
        video_width="${video_width}"
        video_height="${video_height}"
        min_depth="0.1"
        max_depth="100"
        rate="10" />

      <xacro:camera_plugin
        node_namespace="${node_namespace}"
        node_name="${node_name}_left_sensor"
        topic_prefix="${topic_prefix}_left_sensor"
        gazebo_ignition="${gazebo_ignition}"
        optical_frame="${frame_prefix}left_camera_frame_optical"
        reference_frame="${frame_prefix}left_camera_frame_optical"
        horizontal_fov="${horizontal_fov}"
        vertical_fov="${vertical_fov}"
        video_width="${video_width}"
        video_height="${video_height}"
        min_depth="0.1"
        max_depth="100"
        rate="10" />

      <xacro:depth_camera_plugin
        node_namespace="${node_namespace}"
        node_name="${node_name}_depth"
        topic_prefix="${topic_prefix}_depth"
        gazebo_ignition="${gazebo_ignition}"
        optical_frame="${frame_prefix}left_camera_frame_optical"
        reference_frame="${frame_prefix}left_camera_frame_optical"
        horizontal_fov="${horizontal_fov}"
        vertical_fov="${vertical_fov}"
        video_width="${video_width}"
        video_height="${video_height}"
        min_depth="${min_depth}"
        max_depth="${max_depth}"
        rate="10" />
    </xacro:if>

    <xacro:unless value="$(arg low_performance)">
      <xacro:camera_plugin
        node_namespace="${node_namespace}"
        node_name="${node_name}_right_sensor"
        topic_prefix="${topic_prefix}_right_sensor"
        gazebo_ignition="${gazebo_ignition}"
        optical_frame="${frame_prefix}right_camera_frame_optical"
        reference_frame="${frame_prefix}right_camera_frame_optical"
        horizontal_fov="${horizontal_fov}"
        vertical_fov="${vertical_fov}"
        video_width="${video_width}"
        video_height="${video_height}"
        min_depth="0.1"
        max_depth="100"
        rate="30" />

      <xacro:camera_plugin
        node_namespace="${node_namespace}"
        node_name="${node_name}_left_sensor"
        topic_prefix="${topic_prefix}_left_sensor"
        gazebo_ignition="${gazebo_ignition}"
        optical_frame="${frame_prefix}left_camera_frame_optical"
        reference_frame="${frame_prefix}left_camera_frame_optical"
        horizontal_fov="${horizontal_fov}"
        vertical_fov="${vertical_fov}"
        video_width="${video_width}"
        video_height="${video_height}"
        min_depth="0.1"
        max_depth="100"
        rate="30" />

      <xacro:depth_camera_plugin
        node_namespace="${node_namespace}"
        node_name="${node_name}_depth"
        topic_prefix="${topic_prefix}_depth"
        gazebo_ignition="${gazebo_ignition}"
        optical_frame="${frame_prefix}left_camera_frame_optical"
        reference_frame="${frame_prefix}left_camera_frame_optical"
        horizontal_fov="${horizontal_fov}"
        vertical_fov="${vertical_fov}"
        video_width="${video_width}"
        video_height="${video_height}"
        min_depth="${min_depth}"
        max_depth="${max_depth}"
        rate="30" />
    </xacro:unless>
  </xacro:macro>
</robot>
